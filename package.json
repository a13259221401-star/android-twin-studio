{
  "name": "android-wifi-phone-mirror-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "serve": "tsx server/index.ts",
    "preview": "vite preview",
    "runtime:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-mirror-runtime.ps1",
    "runtime:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mirror-runtime.ps1",
    "demo": "npm run runtime:start && npm run dev"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "express": "^5.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
